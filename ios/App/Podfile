require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

# =====================================================================
# Keep the hosted payment page INSIDE the app.
#
# Capacitor's default WKUIDelegate hands every new window to Safari:
#
#   UIApplication.shared.open(url, options: [:], completionHandler: nil)
#
# So when Payfast opens a step in a new window, iOS kicks the customer out
# of Evasale into Safari — the app is left behind, the payment looks
# broken, and coming back to the app loses the flow.
#
# We patch it to load the URL in the SAME WKWebView instead, and we enable
# window.open() in JavaScript, which WKWebView blocks by default (Capacitor
# never enables it), so a blocked popup could stall the payment step.
#
# Capacitor is installed as a development pod (`:path =>`), so CocoaPods
# compiles the Swift straight out of node_modules. That means the patch has
# to be applied to the real source in node_modules — a copy inside Pods/ is
# not what gets compiled.
#
# The patch runs on every `pod install` (which `npx cap sync ios` runs), so
# it survives `npm install`. If the anchors ever change, the patch says so
# loudly instead of silently doing nothing.
# =====================================================================
def patch_capacitor_for_in_app_windows(installer)
  roots = [
    # The real source (development pod) — this is what gets compiled.
    File.expand_path(File.join(__dir__, '../../node_modules/@capacitor/ios/Capacitor')),
    # A copy inside Pods/, in case a future CocoaPods copies the sources.
    File.join(installer.sandbox.root.to_s, 'Capacitor', 'Capacitor')
  ].uniq

  delegate_name = 'WebViewDelegationHandler.swift'
  controller_name = 'CAPBridgeViewController.swift'

  open_call = 'UIApplication.shared.open(url, options: [:], completionHandler: nil)'
  in_app_load = 'webView.load(URLRequest(url: url))'
  controller_anchor = 'webViewConfiguration.allowsInlineMediaPlayback = true'
  controller_patch = "webViewConfiguration.allowsInlineMediaPlayback = true\n        webViewConfiguration.preferences.javaScriptCanOpenWindowsAutomatically = true"

  patched_any = false
  roots.each do |root|
    delegate_file = File.join(root, delegate_name)
    controller_file = File.join(root, controller_name)
    next unless File.exist?(delegate_file)

    content = File.read(delegate_file)
    if content.include?(open_call)
      File.write(delegate_file, content.gsub(open_call, in_app_load))
      puts '[patch] Capacitor: new windows now load inside the app'
      patched_any = true
    elsif !content.include?(in_app_load)
      warn '[patch] WARNING: could not find the UIApplication.shared.open call in ' + delegate_file
      warn '[patch]          The payment page may still open in Safari. Update this Podfile.'
    end

    if File.exist?(controller_file)
      content = File.read(controller_file)
      unless content.include?('javaScriptCanOpenWindowsAutomatically = true')
        patched = content.sub(controller_anchor, controller_patch)
        if patched != content
          File.write(controller_file, patched)
          puts '[patch] Capacitor: window.open() enabled for the payment flow'
          patched_any = true
        else
          warn '[patch] WARNING: could not find the webview configuration anchor in ' + controller_file
        end
      end
    end
  end

  unless patched_any
    warn '[patch] WARNING: the Capacitor iOS patch did not apply. The hosted payment page may open in Safari.'
  end
end

post_install do |installer|
  assertDeploymentTarget(installer)
  patch_capacitor_for_in_app_windows(installer)
end
